{
  "name": "frame-desktop",
  "version": "0.1.5",
  "private": true,
  "description": "Frame editing workstation",
  "author": "Vexora",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check desktop/main.cjs && node --check desktop/preload.cjs",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac zip --arm64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.vexora.frame",
    "productName": "Frame",
    "directories": {
      "output": "final-dist"
    },
    "files": [
      "desktop/*.cjs",
      "desktop/update-key.pem",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "vendor/${os}-${arch}",
        "to": "vendor"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Frame-Windows-x64-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.video",
      "artifactName": "Frame-Mac-M2-arm64.${ext}",
      "hardenedRuntime": true,
      "identity": null
    },
    "linux": {
      "target": "dir"
    }
  }
}
